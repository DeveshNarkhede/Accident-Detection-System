# Email Settings (Example for Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=hostgmail.com
EMAIL_HOST_PASSWORD=Host Password
DEFAULT_FROM_EMAIL=host@gmail.com
ALERT_EMAIL=host@gmail.com

# Twilio SMS Settings
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+19876543210
TWILIO_TO_NUMBER=+911234567890
